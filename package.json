{
  "name": "petcare-hub-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "PetCare Hub - Platform for Pet Rescue, Adoption & Non-Profit Supplies Support (Microservices Monorepo)",
  "workspaces": [
    "frontend",
    "packages/*",
    "backend/api-gateway",
    "backend/services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@petcare-hub/frontend",
    "dev:frontend": "npm run dev --workspace=@petcare-hub/frontend",
    "build": "npm run build --workspace=@petcare-hub/frontend",
    "build:frontend": "npm run build --workspace=@petcare-hub/frontend",
    "lint": "npm run lint --workspace=@petcare-hub/frontend",
    "preview": "npm run preview --workspace=@petcare-hub/frontend"
  },
  "keywords": [
    "petcare-hub",
    "rescue",
    "adoption",
    "react",
    "microservices",
    "monorepo"
  ],
  "author": "",
  "license": "MIT"
}
